<%= content_tag :tr, id: "todo-form-#{issue.number}" do %>
  <td>
    <%= form_with(model: [issue, issue.todos.new], local: true)  do |f| %>
      <ol>
        <li class="todo-status">
          <%= f.text_field  :status %>
        </li>
  
        <li class="todo-action">
          <%= f.text_field  :action %>
        </li>
  
        <li class="todo-submit">
          <%= f.submit value: "&#xf060;".html_safe, class: 'fas' %>
        </li>
      </ol>
    <% end %>
  </td>
<% end %>
