<table class="table table-striped">
  <% @issues.each do |issue| %>
    <tr>
      <td><%= issue.number         %></td>
      <td><%= issue.subject        %></td>
      <td><%= issue.logpath        %></td>
      <td><%= issue.salesforce_url %></td>
      <td><%= issue.ftp_url        %></td>
      <td><%= issue.fix            %></td>
    </tr>
  <% end %>
</table>

