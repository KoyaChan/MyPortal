    <table class="table table-condensed table-hover">
      <tr class="success">
        <td>
          <% issue_id = @issue_item.id %>
          <%= check_box "issue", "expand", {id: "check_#{issue_id}", checked: false, onclick: "expand(#{issue_id})"}, true, false %>
        </td>
          <td><%= link_to @issue_item.number, @issue_item.salesforce_url %></td>
          <td><%= @issue_item.subject                              %></td>
          <td><%= link_to 'ログ保存先', @issue_item.logpath        %></td>
          <td><%= link_to 'ftp',        @issue_item.ftp_url        %></td>
          <td><%= @issue_item.fix                                  %></td>
      </tr>
      <tr>
        <td>
          <%= content_tag :div, id: "issue_extra_#{@issue_item.id}", style: "display:none" do %>
            <table class="table table-condensed table-hover">
              <tr>
                <td><%= link_to '編集',       "issues/#{@issue_item.id}/edit"   %></td>
              </tr>
            </table>
          <% end %>
        </td>
      </tr>
    </table>

