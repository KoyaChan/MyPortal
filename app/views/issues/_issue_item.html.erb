    <table class="table table-condensed table-hover">
      <tr class="success">
        <td>
          <% issue_number = @issue_item.number %>
          <%= check_box "issue", "expand", {id: "check_#{issue_number}", checked: false, onclick: "expand(#{issue_number})"}, true, false %>
          <%= label "check", "#{issue_number}" %>
        </td>
        <td>
          <%= link_to        "issues/#{@issue_item.id}/edit"   do %>
            <i class="fa fa-edit"></i>
          <% end %>
        </td>
          <td><%= link_to 'salesforce', @issue_item.salesforce_url, target: "_blank" %></td>
          <td><%= @issue_item.subject                              %></td>
          <td><%= link_to 'ログ保存先', @issue_item.logpath, target: "_blank"        %></td>
          <td><%= link_to 'ftp',        @issue_item.ftp_url, target: "_blank"        %></td>
          <td><%= @issue_item.fix                                  %></td>
      </tr>
      <tr>
        <td>
          <%= content_tag :div, id: "issue_extra_#{issue_number}", style: "display:none" do %>
            <table class="table table-condensed table-hover">
              <tr>
                <td><%= simple_format(@issue_item.memo)                                     %></td>
              </tr>
            </table>
          <% end %>
        </td>
      </tr>
    </table>

