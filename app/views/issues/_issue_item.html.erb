    <%= content_tag :table, class: 'table table-hover' do %>
      <% issue_number = @issue_item.number %>

      <%= content_tag :tr, class: 'success' do %>
        <%= render 'issue_item_base', object: @issue_item %>
      <% end %>

      <%= render 'todos/todo_form', object: @issue_item %>

      <% @todos = @issue_item.todos.select{|todo| !todo.id.nil?} %>
      <%= render @todos %>

      <%= content_tag :tr, id: "issue_extra_#{issue_number}", style: 'display:none' do %>
        <%= render 'issue_extra_block', object: @issue_item %>
      <% end %>
    <% end %>
