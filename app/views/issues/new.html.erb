<%= bootstrap_form_with(model: @issue, local: true, class: 'col-xs-4') do |f|  %>
    <%= f.number_field :number,         label: 'Issue番号 :'  %>
    <%= f.text_area   :subject,         label: '件名 :'       %>
    <%= f.text_field   :logpath,        label: 'ログ保存先 :' %>
    <%= f.url_field    :salesforce_url, label: 'salesforce :' %>
    <%= f.url_field    :ftp_url,        label: 'ftp :'        %>
    <%= f.text_field   :fix,            label: 'fix :'        %>
    <%= f.submit       '保存', class: 'btn btn-success'       %>
<% end %>
