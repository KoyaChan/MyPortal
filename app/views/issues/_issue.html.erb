  <li>
    <%= content_tag :table, class: 'table table-hover' do %>
      <% issue_number = issue.number %>

      <%= content_tag :tr, class: 'success' do %>
        <%= render 'issue_item_base', issue: issue %>
      <% end %>

      <%= render 'todos/todo_form',   issue: issue %>

      <% @todos = issue.todos.select{|todo| !todo.id.nil?} %>
      <%= render @todos, issue: issue %>

      <%= content_tag :tr, id: "issue_extra_#{issue_number}", style: 'display:none' do %>
        <%= render 'issue_extra_block', issue: issue %>
      <% end %>
    <% end %>
  </li>
