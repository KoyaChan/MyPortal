        <% issue_number = issue.number %>
        <td>
          <div class="issue-item-base">
            <div class="issue-number">
              <%= check_box "issue", "expand", {id: "check_#{issue_number}", checked: false, onclick: "expand(#{issue_number})"}, true, false %>
              <%= label "check", "#{issue_number}", class: "issue-number-label" %>
            </div>

            <div class="issue-subject">
              <%= issue.subject                              %>
            </div>

            <div class="issue-icon">
              <%= check_box "todo_form", "show", {id: "show-todo-form_#{issue_number}", checked: false, onclick: "show_todo_form(#{issue_number})"}, true, false %>
              <label for=<%="show-todo-form_#{issue_number}"%> class= "todo-form-label"></label>
            </div>

            <%= link_to   issue.salesforce_url, target: '_blank', class: 'issue-icon' do %>
              <%= image_tag 'salesforce.png', size: '20x20' %>
            <% end %>

            <% jira_enabled = issue.number.present? && issue.cft_number.present? %>
            <% if jira_enabled %>
              <%= link_to   issue.jira_url,     target: '_blank', class: 'issue-icon' do %>
                <%= image_tag 'Jira.png', size: '20x20', alt: 'JIRA' %>
              <% end %>
            <% else %>
              <span class="issue-icon issue-icon-disabled">
                <%= image_tag 'Jira.png', size: '20x20', alt: 'JIRA' %>
              </span>
            <% end %>

            <%= link_to   edit_issue_path(issue),                 class: 'issue-icon' do %>
              <i class="fa fa-edit"></i>
            <% end %>

            <% memopath_link_id = "memopath-#{issue_number}" %>
            <%= link_to   "", name: issue.memopath, id: "#{memopath_link_id}", class: 'issue-icon', onclick: "name_to_clipboard(\"#{memopath_link_id}\")" do %>
              <i class="fa fa-eye"></i>
            <% end %>

            <% logpath_link_id = "logpath-#{issue_number}" %>
            <%= link_to   "", name: issue.logpath, id: "#{logpath_link_id}", class: 'issue-icon', onclick: "name_to_clipboard(\"#{logpath_link_id}\")" do %>
              <i class="fa fa-folder-open"></i>
            <% end %>

            <%= link_to   issue.ftp_url,        target: '_blank', class: 'issue-icon' do %>
              <i class="fa fa-download"></i>
            <% end %>

            <%= link_to   issue,                method: :delete,  class: 'issue-icon' do%>
              <i class="fa fa-trash-alt"></i>
            <% end %>

          </div>
        </td>

