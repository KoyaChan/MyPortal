        <% issue_number = issue.number %>
        <td>
          <div class="issue-item-base">
            <div class="issue-number">
              <%= check_box "issue", "expand", {id: "check_#{issue_number}", checked: false, onclick: "expand(#{issue_number})"}, true, false %>
              <%= label "check", "#{issue_number}", class: "issue-number-label" %>
            </div>

            <div class="issue-subject">
              <%= issue.subject                              %>
            </div>

            <div class="issue-icon">
              <%= link_to   issue.salesforce_url, target: '_blank' do %>
                <%= image_tag 'salesforce.png', size: '20x20' %>
              <% end %>
            </div>

            <div class="issue-icon">
              <%= link_to        "issues/#{issue.id}/edit"   do %>
                <i class="fa fa-edit"></i>
              <% end %>
            </div>

            <div class="issue_icon">
              <%= link_to        issue.logpath, target: '_blank' do %>
                <i class="fa fa-folder-open"></i>
              <% end %>
            </div>

            <div class="issue_icon">
              <%= link_to      issue.ftp_url, target: '_blank' do %>
                <i class="fa fa-download"></i>
              <% end %>
            </div>

            <div class="issue_icon">
              <%= check_box "todo_form", "show", {id: "show-todo-form_#{issue_number}", checked: false, onclick: "show_todo_form(#{issue_number})"}, true, false %>
              <label for=<%="show-todo-form_#{issue_number}"%> class= "todo-form-label"></label>
            </div>

          </div>
        </td>

